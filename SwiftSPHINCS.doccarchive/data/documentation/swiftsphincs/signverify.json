{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS\/SignVerify"},"hierarchy":{"paths":[["doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS"]]},"metadata":{"modules":[{"name":"SwiftSPHINCS"}],"role":"article","roleHeading":"Article","title":"Sign and Verify"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","variants":[{"paths":["\/documentation\/swiftsphincs\/signverify"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"anchor":"Additional-Information","identifiers":["doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS\/KeyManagement","doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS\/OIDs","doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS\/Performance","doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS\/References"],"title":"Additional Information"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"","text":""},{"inlineContent":[{"type":"text","text":"Messages are signed by secret keys and signatures are verified by public keys."},{"type":"text","text":" "},{"type":"text","text":"Signatures can be deterministic or randomized and optionally a hash of the message can be signed"},{"type":"text","text":" "},{"type":"text","text":"instead of the message itself."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Example","text":"Example"},{"syntax":"swift","code":["import SwiftSPHINCS","","\/\/ Create the SPHINCS keys","","let (secretKey, publicKey) = SPHINCS.GenerateKeyPair(kind: .SHA2_128f)","","\/\/ Deterministic signature","let deterministicSig = secretKey.Sign(message: [1, 2, 3], randomize: false)","print(\"Deterministic:\", publicKey.Verify(message: [1, 2, 3], signature: deterministicSig))","","\/\/ Randomized signature","let randomizedSig = secretKey.Sign(message: [1, 2, 3], randomize: true)","print(\"Randomized:\", publicKey.Verify(message: [1, 2, 3], signature: randomizedSig))","","\/\/ Pre-hashed signature","let preHashedSig = secretKey.Sign(message: [1, 2, 3], ph: .SHA256)","print(\"Pre-hashed:\", publicKey.Verify(message: [1, 2, 3], signature: preHashedSig, ph: .SHA256))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"giving:"}],"type":"paragraph"},{"syntax":null,"code":["Deterministic: true","Randomized: true","Pre-hashed: true"],"type":"codeListing"}]}],"references":{"doc://swiftsphincs.SwiftSPHINCS/documentation/SwiftSPHINCS":{"title":"SwiftSPHINCS","type":"topic","url":"\/documentation\/swiftsphincs","abstract":[{"type":"text","text":"Stateless Hash-Based Digital Signature Standard"}],"kind":"symbol","identifier":"doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS","role":"collection"},"doc://swiftsphincs.SwiftSPHINCS/documentation/SwiftSPHINCS/KeyManagement":{"identifier":"doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS\/KeyManagement","abstract":[],"title":"Key Management","url":"\/documentation\/swiftsphincs\/keymanagement","kind":"article","role":"article","type":"topic"},"doc://swiftsphincs.SwiftSPHINCS/documentation/SwiftSPHINCS/Performance":{"url":"\/documentation\/swiftsphincs\/performance","title":"Performance","kind":"article","type":"topic","identifier":"doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS\/Performance","role":"article","abstract":[]},"doc://swiftsphincs.SwiftSPHINCS/documentation/SwiftSPHINCS/OIDs":{"identifier":"doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS\/OIDs","role":"article","abstract":[],"url":"\/documentation\/swiftsphincs\/oids","kind":"article","type":"topic","title":"ASN1 OIDs"},"doc://swiftsphincs.SwiftSPHINCS/documentation/SwiftSPHINCS/References":{"kind":"article","url":"\/documentation\/swiftsphincs\/references","identifier":"doc:\/\/swiftsphincs.SwiftSPHINCS\/documentation\/SwiftSPHINCS\/References","abstract":[],"type":"topic","title":"References","role":"articl